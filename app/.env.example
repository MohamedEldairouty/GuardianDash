# Copy this file to ".env" and edit the URL to your laptop's LAN IP.
# Expo automatically loads any env var that starts with EXPO_PUBLIC_*
# into the app bundle. When this is set, the app SKIPS the in-app
# backend setup screen entirely.
#
# Find your laptop's IP with:
#   Windows:  ipconfig          (look for "IPv4 Address" under Wi-Fi)
#   Mac/Linux: ifconfig | grep inet
#
# Then start Expo as usual:
#   cd app
#   npx expo start --tunnel
#
# Restart Expo after changing this file — env vars are baked in at bundle time.

EXPO_PUBLIC_API_BASE=http://192.168.1.42:4000
